# Copy to .env. Every line is optional: with none set, Sidenote uses its built-in notes logic.
# Set a key to turn a provider on. The first configured one becomes the default.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Pick a default (otherwise the first configured provider and its first model)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5

# Point at any OpenAI-compatible server, e.g. LM Studio, or a local Ollama
# OPENAI_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Replace a provider's model list (comma separated)
# ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-4-5-20251001
